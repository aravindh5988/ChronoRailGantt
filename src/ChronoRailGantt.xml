<?xml version="1.0" encoding="utf-8"?>
<widget id="com.rbt.chronorailgantt.ChronoRailGantt" pluginWidget="true" needsEntityContext="false" offlineCapable="true" supportedPlatform="Web" xmlns="http://www.mendix.com/widget/1.0/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.mendix.com/widget/1.0/ ../node_modules/mendix/custom_widget.xsd">
  <name>ChronoRail Gantt</name>
  <description>Displays tasks from a Mendix list data source on an interactive Gantt timeline.</description>
  <studioProCategory>Data widgets</studioProCategory>
  <helpUrl>https://docs.mendix.com/apidocs-mxsdk/apidocs/pluggable-widgets/</helpUrl>
  <icon></icon>
  <properties>
    <propertyGroup caption="Data">
      <property key="data" type="datasource" isList="true" required="true">
        <caption>Task data source</caption>
        <description>The list of task objects to render.</description>
      </property>
      <property key="taskName" type="attribute" dataSource="data" required="true">
        <caption>Task name</caption>
        <description>Text displayed for each task.</description>
        <attributeTypes>
          <attributeType name="String" />
        </attributeTypes>
      </property>
      <property key="taskStart" type="attribute" dataSource="data" required="true">
        <caption>Start date</caption>
        <description>The task start date and time.</description>
        <attributeTypes>
          <attributeType name="DateTime" />
        </attributeTypes>
      </property>
      <property key="taskEnd" type="attribute" dataSource="data" required="true">
        <caption>End date</caption>
        <description>The task end date and time.</description>
        <attributeTypes>
          <attributeType name="DateTime" />
        </attributeTypes>
      </property>
      <property key="taskProgress" type="attribute" dataSource="data" required="false">
        <caption>Progress</caption>
        <description>Optional percentage from 0 through 100.</description>
        <attributeTypes>
          <attributeType name="Integer" />
          <attributeType name="Decimal" />
        </attributeTypes>
      </property>
      <property key="taskColor" type="attribute" dataSource="data" required="false">
        <caption>Task color</caption>
        <description>Optional CSS color for each task.</description>
        <attributeTypes>
          <attributeType name="String" />
        </attributeTypes>
      </property>
      <property key="taskStatus" type="attribute" dataSource="data" required="false">
        <caption>Task status</caption>
        <description>Optional String task status. Status colors and the status filter use this value.</description>
        <attributeTypes>
          <attributeType name="String" />
        </attributeTypes>
      </property>
      <property key="taskDependencies" type="attribute" dataSource="data" required="false">
        <caption>Dependencies</caption>
        <description>Optional comma-separated predecessor object IDs for dependency arrows.</description>
        <attributeTypes>
          <attributeType name="String" />
        </attributeTypes>
      </property>
    </propertyGroup>
    <propertyGroup caption="Timeline">
      <property key="viewMode" type="enumeration" defaultValue="week">
        <caption>Initial view</caption>
        <description>Timeline scale.</description>
        <enumerationValues>
          <enumerationValue key="day">Day</enumerationValue>
          <enumerationValue key="week">Week</enumerationValue>
          <enumerationValue key="month">Month</enumerationValue>
        </enumerationValues>
      </property>
      <property key="rowHeight" type="integer" defaultValue="44">
        <caption>Row height</caption>
        <description>Height of every task row in pixels.</description>
      </property>
      <property key="showToday" type="boolean" defaultValue="true">
        <caption>Show today marker</caption>
        <description>Shows a vertical line for the current date.</description>
      </property>
      <property key="emptyMessage" type="string" defaultValue="No tasks to display.">
        <caption>Empty message</caption>
        <description>Message displayed when the data source is empty.</description>
      </property>
    </propertyGroup>
    <propertyGroup caption="Interaction">
      <property key="allowEditing" type="boolean" defaultValue="false">
        <caption>Allow drag editing</caption>
        <description>Allows users to drag a task to update its start and end dates.</description>
      </property>
      <property key="onTaskClick" type="action" dataSource="data" required="false">
        <caption>On task click</caption>
        <description>Action executed after a task is selected. The selected task is passed to the action.</description>
      </property>
      <property key="onTaskChanged" type="action" dataSource="data" required="false">
        <caption>On task changed</caption>
        <description>Action executed after a task date is changed. The changed task and new dates are passed to the action.</description>
        <actionVariables>
          <actionVariable key="changedStartDate" type="DateTime" caption="New start date" />
          <actionVariable key="changedEndDate" type="DateTime" caption="New end date" />
        </actionVariables>
      </property>
    </propertyGroup>
    <propertyGroup caption="Visibility">
      <systemProperty key="Visibility" />
    </propertyGroup>
  </properties>
</widget>